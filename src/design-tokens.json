{
  "meta": {
    "name": "Claude Workspace Design System",
    "version": "1.0.0",
    "concept": "Content-first, warm minimal — Notion×Stripe inspired"
  },
  "color": {
    "primary": {
      "50": "#fef7f0",
      "100": "#fdebd6",
      "200": "#fad4ac",
      "300": "#f5b777",
      "400": "#ef9543",
      "500": "#e8792a",
      "600": "#c9621e",
      "700": "#a74d19",
      "800": "#873e1a",
      "900": "#6e3418"
    },
    "neutral": {
      "0": "#ffffff",
      "25": "#fcfcfb",
      "50": "#f9f8f6",
      "100": "#f3f2ef",
      "150": "#eceae6",
      "200": "#e3e1dc",
      "300": "#d0cdc6",
      "400": "#a8a49b",
      "500": "#87827a",
      "600": "#6b6860",
      "700": "#504d47",
      "800": "#37352f",
      "900": "#1f1e1b"
    },
    "success": {
      "50": "#f0faf4",
      "500": "#22a55b",
      "600": "#1a8a4c"
    },
    "warning": {
      "50": "#fef9ee",
      "500": "#e0960c",
      "600": "#c2800a"
    },
    "error": {
      "50": "#fef2f2",
      "500": "#e5484d",
      "600": "#ce3e42"
    },
    "info": {
      "50": "#f0f5ff",
      "500": "#3b82f6",
      "600": "#2563eb"
    },
    "semantic": {
      "bg-primary": "{neutral.0}",
      "bg-secondary": "{neutral.50}",
      "bg-tertiary": "{neutral.100}",
      "bg-surface": "{neutral.0}",
      "bg-hover": "{neutral.100}",
      "bg-active": "{neutral.150}",
      "bg-code-inline": "{neutral.100}",
      "bg-code-block": "{neutral.50}",
      "text-primary": "{neutral.800}",
      "text-secondary": "{neutral.600}",
      "text-muted": "{neutral.400}",
      "text-inverse": "{neutral.0}",
      "border-default": "{neutral.200}",
      "border-subtle": "{neutral.150}",
      "border-focus": "{primary.400}",
      "accent": "{primary.500}",
      "accent-hover": "{primary.600}",
      "accent-light": "rgba(232, 121, 42, 0.1)",
      "accent-subtle": "{primary.50}"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', sans-serif",
      "mono": "'SF Mono', 'JetBrains Mono', 'Fira Code', monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12px",
      "base": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "18px",
      "2xl": "22px",
      "3xl": "28px"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.3,
      "base": 1.5,
      "relaxed": 1.7
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.02em",
      "wider": "0.04em"
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "xs": "0 1px 2px rgba(0,0,0,0.04)",
    "sm": "0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)",
    "md": "0 4px 6px rgba(0,0,0,0.05), 0 2px 4px rgba(0,0,0,0.03)",
    "focus": "0 0 0 2px rgba(232, 121, 42, 0.15)"
  },
  "motion": {
    "duration": {
      "fast": "100ms",
      "base": "150ms",
      "slow": "250ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)"
    }
  },
  "layout": {
    "sidebar-width": "220px",
    "sidebar-collapsed": "0px",
    "header-height": "36px",
    "tab-height": "32px",
    "titlebar-height": "28px",
    "divider-width": "1px"
  },
  "prohibited": [
    "shadow-lg, shadow-xl — shadow-sm で十分",
    "text-black — neutral.800 を使う",
    "border-l-4 カラーバー — border + rounded で全周",
    "bg-gradient-* — フラットカラーのみ",
    "絵文字の多用 — アイコンは最小限",
    "opacity-50 でテキストを薄くする — text-muted トークンを使う",
    "ハードコード色 (#xxx) — トークンのCSS変数を使う",
    "font-size: 10px 以下 — xs (11px) が最小",
    "border-radius: 16px 以上 — xl (12px) が最大（pill除く）",
    "複数フォントウェイトの混在 — 1画面で3種まで"
  ]
}
